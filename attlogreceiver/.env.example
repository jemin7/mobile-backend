NODE_ENV=development
PORT=8000
HOST=127.0.0.1

# PostgreSQL database ATTLOG_DB. Do not point this at the OpenHRM database.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/ATTLOG_DB

# Server-to-server secret for OpenHRM pull, device sync, and mobile punches.
# Never ship this in a mobile app.
RECEIVER_KEY=replace-with-receiver-secret

ADMIN_AUTH_SECRET=replace-with-admin-secret

TIMEZONE=Asia/Kolkata

# Dahua HTTP Basic credentials. Required for Dahua routes.
DAHUA_BASIC_USER=
DAHUA_BASIC_PASSWORD=

# Comma-separated client IPs. Empty disables the allowlist.
DEVICE_IP_ALLOWLIST=

BODY_LIMIT=1mb

# Embedded worker runs inside the API process. Set false when using start:worker.
WORKER_EMBEDDED=true
WORKER_INTERVAL_MS=2000
WORKER_BATCH_SIZE=50
PROCESSING_MAX_RETRIES=5
